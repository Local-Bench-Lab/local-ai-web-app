{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama on the GB10",
      "options": {
        "baseURL": "http://172.17.0.1:11434/v1"
      },
      "models": {
        "gpt-oss:120b": {
          "name": "gpt-oss 120B"
        },
        "qwen3-coder-next": {
          "name": "Qwen3-Coder-Next"
        },
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "ollama/gpt-oss:120b",
  "mcp": {
    "figcraft": {
      "type": "local",
      "command": [
        "/config/.local/bin/figcraft-cli",
        "mcp",
        "--attach",
        "47801"
      ],
      "enabled": true
    }
  }
}