#!/usr/bin/env python3
"""next-agent "<what just happened>": the decision gate - asks the Qwen judge which agent runs next (see clm_gate.py)."""
import json, os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__))))
os.environ.setdefault("OLLAMA", "http://127.0.0.1:11434")
from clm_gate import judge_pick
actions = json.load(open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "routing_cases.json")))["actions"]
actions = {"developer": "Fix the problems a reviewer or checker just found, then re-check.", **actions}
choice, reason, s = judge_pick(sys.argv[1], actions)
print(f"next: {choice}  ({s:.1f} s)\nwhy:  {reason}")
